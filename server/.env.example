# ── Server ────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=production
# Number of proxies in front of the app (ALB only → 1, CloudFront + ALB → 2).
# Defaults to 1 when NODE_ENV=production, 0 otherwise.
# TRUST_PROXY=1

# ── Mode ──────────────────────────────────────────────────────────────
# true  — shop mode: checkout + Stripe, products from PostgreSQL.
#         Needs everything in the two sections below.
# unset — portfolio mode: products from data/products.json, contact form
#         only. The PostgreSQL and Stripe settings are ignored.
# Keep in step with VITE_COMMERCE_ENABLED in the frontend .env.
COMMERCE_ENABLED=

# ── PostgreSQL (shop mode only) ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=art_ecommerce
DB_USER=
DB_PASSWORD=

# ── Stripe (shop mode only) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Minutes an item stays reserved while a buyer is checking out
# RESERVATION_TTL_MINUTES=30

# ── Email via Resend (required when NODE_ENV=production) ──────────────
# API key with "Sending access" only. The from address must be on a domain
# verified in Resend; keep open and click tracking off for that domain
# (the privacy policy says there's no tracking).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_OWNER_ADDRESS=
# Optional blind copy of every contact message, as the UK operator's record
# of the visitor's consent. Delete copies after the period in Privacy.jsx.
EMAIL_COPY_ADDRESS=
