# ── Server ────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# NODE_ENV=production
# Number of proxies in front of the app (ALB only → 1, CloudFront + ALB → 2).
# Defaults to 1 when NODE_ENV=production, 0 otherwise.
# TRUST_PROXY=1

# ── PostgreSQL ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=art_ecommerce
DB_USER=
DB_PASSWORD=

# ── Stripe (optional) ─────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY blank to run in portfolio mode: checkout and
# webhook routes answer 503, products and contact keep working.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Minutes an item stays reserved while a buyer is checking out
# RESERVATION_TTL_MINUTES=30

# ── AWS SES (required when NODE_ENV=production) ───────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_ADDRESS=
SES_OWNER_ADDRESS=
# Optional blind copy of every contact message, as the UK operator's record
# of the visitor's consent. Delete copies after the period in Privacy.jsx.
SES_COPY_ADDRESS=
