# Leave blank when the frontend and API share the same origin.
VITE_API_BASE_URL=
VITE_PRODUCTS_ENDPOINT=/api/products

# "true" builds the shop (cart, Buy Now, /checkout). Leave blank for the
# portfolio site — the shop's code is then left out of the build.
# Keep in step with COMMERCE_ENABLED in server/.env.
VITE_COMMERCE_ENABLED=
# Shop mode only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
