// Cloudflare Worker for the live site: the website files plus the
// portfolio-mode API. See worker/index.js.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "art-ecommerce",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-20",
  // Puts the Worker's variables and secrets in process.env, where the
  // shared email code reads them
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Paths with no file (/about, /shop?art=3, …) get index.html, so the
    // React app can show the right page
    "not_found_handling": "single-page-application",
    // Everything reaches worker/index.js first (so /api works and www
    // pages can be redirected) except the built code and the images,
    // which are served straight from storage: faster, and they don't
    // count toward the Worker's free daily requests
    "run_worker_first": ["/*", "!/assets/*", "!/images/*"]
  },

  // Contact form: at most 3 messages a minute from one address. The
  // namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  "observability": { "enabled": true },

  // Preview builds: Cloudflare runs `wrangler preview` for every branch
  // except main, giving it its own test URL. That fails unless this
  // block exists, and Previews don't inherit settings from above, so
  // anything worker/index.js reads from env is repeated here. The
  // limiter gets its own namespace so test traffic can't use up the live
  // site's limit. No email secrets are given to Previews, so their
  // contact form can't send real enquiries to the artist.
  "previews": {
    "ratelimits": [
      {
        "name": "CONTACT_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 3, "period": 60 }
      }
    ]
  }
}
